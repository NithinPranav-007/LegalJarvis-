# Needhi (formerly LegalJarvis) — Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual environment values.
# NEVER commit .env to version control or Git.

# Application Identity & Mode
APP_NAME=Needhi
APP_ENV=development
DEBUG=false

# Database Configuration
# SQLite local file engine:
DATABASE_URL=sqlite:///legaljarvis_local.db
SYNC_DATABASE_URL=sqlite:///legaljarvis_local.db
# PostgreSQL 16 with pgvector (production):
# DATABASE_URL=postgresql+asyncpg://legaljarvis:legaljarvis_dev_pass@localhost:5432/legaljarvis
# SYNC_DATABASE_URL=postgresql://legaljarvis:legaljarvis_dev_pass@localhost:5432/legaljarvis
POSTGRES_DB=legaljarvis
POSTGRES_USER=legaljarvis
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_PORT=5432

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_hex_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Gateway Configuration
# Providers supported: gemini, openai, anthropic, local, fake
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
# Alternative models: gemini-1.5-pro, gpt-4o, gpt-4o-mini, claude-3-5-sonnet-20241022
LLM_API_KEY=your_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_BASE_URL=
LLM_TEMPERATURE=0.0

# Neural Embedding & Reranking Architecture
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-base
EMBED_DIMENSION=1024

# Ingestion & System Quotas
MAX_DOWNLOAD_GB=5.0
UPLOAD_RETENTION_DAYS=30
MAX_UPLOAD_SIZE_MB=20
RATE_LIMIT_PER_HOUR=30

# Network Host & Port Bindings
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
