# LegalJarvis Environment Configuration (Placeholders Only)
# Copy this file to .env and replace placeholders with real local values.
# NEVER commit .env to Git.

# Database (PostgreSQL 16 with pgvector)
DATABASE_URL=postgresql+asyncpg://legaljarvis:legaljarvis_dev_pass@localhost:5432/legaljarvis
SYNC_DATABASE_URL=postgresql://legaljarvis:legaljarvis_dev_pass@localhost:5432/legaljarvis
POSTGRES_DB=legaljarvis
POSTGRES_USER=legaljarvis
POSTGRES_PASSWORD=legaljarvis_dev_pass
POSTGRES_PORT=5432

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_hex_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM Gateway (openai, anthropic, gemini, local, or fake)
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_API_BASE=
LLM_TEMPERATURE=0.0

# Retrieval & Embeddings
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-base
EMBED_DIMENSION=1024

# Ingestion & System Limits
MAX_DOWNLOAD_GB=5
UPLOAD_RETENTION_DAYS=30
MAX_UPLOAD_SIZE_MB=20
RATE_LIMIT_PER_HOUR=30

# Application Host & Port
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=5173
